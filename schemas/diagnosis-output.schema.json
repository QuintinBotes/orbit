{
  "title": "Orbit diagnosis output",
  "description": "Structured result of a diagnosis step (spec sections 9 and 14). repair_brief mirrors RepairBrief in src/evidence/types.ts, with an absent refuting value written as null. A reworded hypothesis is not a new hypothesis; the controller compares fingerprints and hypotheses itself.",
  "type": "object",
  "additionalProperties": false,
  "required": ["repair_brief", "fingerprint_comparison", "competing_hypotheses", "chosen_hypothesis_id", "confidence"],
  "properties": {
    "repair_brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "evidence", "hypotheses", "experiment", "expected_observation", "scoped_fix", "post_fix_checks", "preserved_constraints"],
      "properties": {
        "fingerprint": { "type": "string", "description": "The normalized failure fingerprint being diagnosed, copied from the evidence." },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "description": "Log paths, excerpts by reference, test names, path:line.",
          "items": { "type": "string" }
        },
        "hypotheses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement", "supporting", "refuting"],
            "properties": {
              "statement": { "type": "string" },
              "supporting": { "type": "string" },
              "refuting": { "type": ["string", "null"] }
            }
          }
        },
        "experiment": { "type": "string", "description": "The smallest authorized experiment that discriminates between the hypotheses." },
        "expected_observation": { "type": "string" },
        "scoped_fix": { "type": "string" },
        "post_fix_checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": { "type": "string" }
        },
        "preserved_constraints": {
          "type": "array",
          "maxItems": 30,
          "description": "What the fix must not change: assertions, criteria, public behaviour.",
          "items": { "type": "string" }
        }
      }
    },
    "fingerprint_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "previous", "relation", "progress", "explanation"],
      "properties": {
        "current": { "type": "string" },
        "previous": {
          "type": "array",
          "maxItems": 30,
          "description": "Fingerprints from earlier attempts, oldest first.",
          "items": { "type": "string" }
        },
        "relation": { "type": "string", "enum": ["first-occurrence", "repeated", "changed"] },
        "progress": { "type": "string", "enum": ["progress", "no-progress", "regression", "unknown"] },
        "explanation": { "type": "string" }
      }
    },
    "competing_hypotheses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "supporting_evidence", "refuting_evidence", "discriminating_experiment", "expected_if_true", "status", "previously_tested"],
        "properties": {
          "id": { "type": "string", "pattern": "^H[0-9]+$" },
          "statement": { "type": "string" },
          "supporting_evidence": { "type": "array", "maxItems": 20, "items": { "type": "string" } },
          "refuting_evidence": { "type": "array", "maxItems": 20, "items": { "type": "string" } },
          "discriminating_experiment": { "type": "string" },
          "expected_if_true": { "type": "string" },
          "status": { "type": "string", "enum": ["leading", "alternative", "ruled-out"] },
          "previously_tested": { "type": "boolean", "description": "True when an earlier attempt already tested this cause." }
        }
      }
    },
    "chosen_hypothesis_id": { "type": "string", "pattern": "^H[0-9]+$" },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "description": "Qualitative only; not a calibrated probability."
    }
  }
}
